{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GPT-HP-BAR",
  "version": "0.1.0",
  "identifier": "com.gpthpbar.app",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GPT-HP-BAR",
        "width": 280,
        "height": 208,
        "minWidth": 232,
        "minHeight": 96,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "url": "index.html"
      },
      {
        "label": "settings",
        "title": "GPT-HP-BAR 设置",
        "width": 760,
        "height": 560,
        "minWidth": 680,
        "minHeight": 500,
        "visible": false,
        "url": "settings.html"
      },
      {
        "label": "mini",
        "title": "GPT-HP-BAR 任务栏",
        "width": 150,
        "height": 44,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "url": "mini.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"]
  }
}
